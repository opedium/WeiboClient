# Backend runtime
PORT=3001
JSON_LIMIT=256kb
UPLOAD_MAX_BYTES=10485760

# Comma-separated allowlist. Example:
# CORS_ORIGINS=https://example.com,https://www.example.com
# Leave empty only if you intentionally allow all origins.
CORS_ORIGINS=

# Auth enforcement for Express backend
# AUTH_REQUIRED=true enables header auth on all non-public routes.
AUTH_REQUIRED=true
# Clients must send this via x-auth-token.
AUTH_TOKEN=replace-with-strong-random-token

# MongoDB mode (optional)
# If MONGODB_URI is empty, app falls back to local file storage.
MONGODB_URI=mongodb+srv://opedium00_db_user:EP7KUbz121qYMbeI@cluster0.nxoucyf.mongodb.net/?appName=Cluster0

MONGODB_DB=weibo_app
MONGODB_COLLECTION=copywriting
MONGODB_ACCOUNTS_COLLECTION=accounts
MONGODB_SCHEDULES_COLLECTION=schedules

# REQUIRED in MongoDB mode: 64-char hex (32 bytes) for AES-256-GCM encryption in db.js.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Optional cookie keep-alive schedule
KEEP_ALIVE_INTERVAL_MS=86400000
KEEP_ALIVE_FIRST_DELAY_MS=21600000
